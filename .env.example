# Database Configuration
MONGODB_URI=mongodb://localhost:27017/harvesthub
# For DigitalOcean Droplet MongoDB:
# MONGODB_URI=mongodb://your-droplet-ip:27017/harvesthub
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/harvesthub

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# DigitalOcean Spaces Configuration
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_ACCESS_KEY_ID=your_access_key_here
DO_SPACES_SECRET_ACCESS_KEY=your_secret_key_here
DO_SPACES_CDN_ENDPOINT=https://your-bucket-name.nyc3.cdn.digitaloceanspaces.com

# Email Configuration (for password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Application Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here