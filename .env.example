 App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/harvesthub

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="HarvestHub <no-reply@yourdomain.com>"
